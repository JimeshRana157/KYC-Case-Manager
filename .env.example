# Copy to .env (never commit the real file).

# Admin account created on startup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password

# MUST be changed outside local development (use a long random string)
JWT_SECRET=dev-only-secret-change-me-please-32chars

# Optional: enables LLM answers in "Ask about this case". Without it, answers are extractive.
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5-5
